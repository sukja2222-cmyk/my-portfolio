<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <title>보육과정론 과제</title>
    <style>
        body {
            font-family: "맑은 고딕", Arial, sans-serif;
            line-height: 1.6;
            margin: 40px;
            background-color: #fffaf0; /* 아이보리색 */
        }
        h1 {
            color: #2c3e50;
        }
        .assignment {
            background: #ffffff;
            border: 2px solid #2c3e50;
            padding: 20px;
            border-radius: 8px;
        }
        .question {
            font-weight: bold;
            margin-bottom: 10px;
        }
        textarea {
            width: 100%;
            height: 150px;
            font-size: 16px;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 6px;
            resize: none;
        }
        .btn-group {
            margin-top: 15px;
        }
        button {
            padding: 10px 20px;
            margin-right: 10px;
            background-color: #2c3e50;
            color: white;
            border: none;
            border-radius: 6px;
            cursor: pointer;
        }
        button:hover {
            background-color: #34495e;
        }
    </style>
</head>
<body>
    <h1>보육과정론 과제</h1>
    <div class="assignment">
        <div class="question">문제: 보육과정론의 의미를 쓰시오.</div>
        <textarea id="answer" placeholder="여기에 답을 작성하세요..."></textarea>
        <div class="btn-group">
            <button onclick="saveFile()">파일로 저장</button>
            <button onclick="clearText()">모두 지우기</button>
            <button onclick="sendEmail()">이메일 전송하기</button>
        </div>
    </div>

    <script>
        function saveFile() {
            const text = document.getElementById("answer").value;
            const blob = new Blob([text], { type: "text/plain;charset=utf-8" });
            const link = document.createElement("a");
            link.href = URL.createObjectURL(blob);
            link.download = "보육과정론_과제.txt";
            link.click();
        }

        function clearText() {
            document.getElementById("answer").value = "";
        }

        function sendEmail() {
            const text = document.getElementById("answer").value;
            const subject = "보육과정론 과제 제출";
            const body = encodeURIComponent(text);
            window.location.href = `mailto:suk-ja11@kakao.com?subject=${subject}&body=${body}`;
        }
    </script>
</body>
</html>
